# Supabase — required for Google sign-in + cloud deck sync (v2.0.0).
# Copy to .env.local and fill in from your Supabase project (Settings → API).
# Both are public-safe: access is enforced by Postgres Row-Level Security,
# not by key secrecy. When absent, the app runs in local-only mode (no sign-in).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
